{
 "workflows": [
  {
   "id": "local-image-v1",
   "kind": "image",
   "version": 1,
   "name": "本地出图",
   "style": "image",
   "description": "用本机 SDXL 出一张图，不做 PBR 分解也不做无缝。不花钱、没有内容审核、种子可复现，代价是提示词遵循度不如云端模型。",
   "resolution": 1024,
   "tileable": false,
   "model_requirements": [],
   "node_packs": [],
   "params": [
    {
     "key": "prompt",
     "label": "提示词",
     "type": "string",
     "multiline": true,
     "target": "dt.positive.text",
     "default": ""
    },
    {
     "key": "negative",
     "label": "负面词",
     "type": "string",
     "multiline": true,
     "target": "dt.negative.text",
     "default": "lowres, bad anatomy, worst quality, watermark, text, signature"
    },
    {
     "key": "width",
     "label": "宽",
     "type": "enum",
     "options": [
      768,
      896,
      1024,
      1152,
      1344
     ],
     "target": "dt.latent.width",
     "default": 1024
    },
    {
     "key": "height",
     "label": "高",
     "type": "enum",
     "options": [
      768,
      896,
      1024,
      1152,
      1344
     ],
     "target": "dt.latent.height",
     "default": 1024,
     "note": "SDXL 在总像素接近 1024² 时最稳；偏离太远容易出双头、重复构图"
    },
    {
     "key": "seed",
     "label": "种子",
     "type": "int",
     "target": "dt.sampler.seed",
     "default": -1,
     "note": "-1 为随机。本地出图的种子是真能复现的，和云端不一样"
    },
    {
     "key": "reference",
     "label": "参考图",
     "type": "image",
     "target": "dt.reference_image.image",
     "note": "留空为纯文生图。给了就在它基础上重绘，幅度在高级参数里调",
     "rewire_when_set": {
      "node": "dt.sampler",
      "input": "latent_image",
      "source": "dt.reference_encode",
      "slot": 0
     },
     "drop_when_empty": [
      "dt.reference_image",
      "dt.reference_scale",
      "dt.reference_encode"
     ]
    }
   ],
   "advanced": [
    {
     "key": "steps",
     "label": "步数",
     "type": "int",
     "target": "dt.sampler.steps",
     "default": 28,
     "min": 10,
     "max": 60
    },
    {
     "key": "cfg",
     "label": "CFG",
     "type": "float",
     "target": "dt.sampler.cfg",
     "default": 6.5,
     "min": 1,
     "max": 15
    },
    {
     "key": "denoise",
     "label": "重绘幅度",
     "type": "float",
     "target": "dt.sampler.denoise",
     "default": 1,
     "min": 0.1,
     "max": 1,
     "note": "仅在给了参考图时有意义"
    },
    {
     "key": "reference_size",
     "label": "参考图缩放",
     "type": "enum",
     "options": [
      768,
      1024,
      1152
     ],
     "target": [
      "dt.reference_scale.width",
      "dt.reference_scale.height"
     ],
     "default": 1024
    },
    {
     "key": "sampler",
     "label": "采样器",
     "type": "string",
     "target": "dt.sampler.sampler_name",
     "default": "dpmpp_2m"
    },
    {
     "key": "scheduler",
     "label": "调度器",
     "type": "string",
     "target": "dt.sampler.scheduler",
     "default": "karras"
    }
   ]
  },
  {
   "id": "src-api-stylized-v1.dec-chord-v1",
   "kind": "material",
   "version": 1,
   "name": "云端底图 · 手绘 · CHORD 分解",
   "style": "stylized",
   "description": "底图交给云端模型出，再由本地 SDXL 叠手绘 LoRA 低幅重绘一遍换取可平铺。 交给 Ubisoft CHORD 一步分解出 BaseColor/Normal/Roughness/Metallic，再由法线反推高度、派生 AO 并打包 ORM。",
   "resolution": 1024,
   "tileable": true,
   "tileable_when_positive": "tile_fix",
   "source": {
    "kind": "api",
    "provider": "openai",
    "image_param": "source_image",
    "roles": {
     "background": "api_background",
     "model": "api_model",
     "prompt": "prompt",
     "quality": "api_quality",
     "reference": "reference",
     "size": "api_size"
    }
   },
   "source_segment": "src-api-stylized-v1",
   "decompose_segment": "dec-chord-v1",
   "mismatch": "CHORD 分解 是为写实画面训练/调参的，云端底图 · 手绘 的产物对它是分布外输入，结果可能明显变差",
   "licenses": [
    {
     "component": "CHORD (dt.pbr_estimate / dt.chord_model)",
     "license": "Ubisoft Machine Learning License (Research-Only, Copyleft)",
     "commercial": false,
     "replaceable_segment": "dt.pbr_estimate",
     "alternatives": [
      "Marigold IID appearance (OpenRAIL++)",
      "PBRFusion4 (Apache 2.0)"
     ]
    }
   ],
   "model_requirements": [],
   "node_packs": [
    "ComfyUI-seamless-tiling",
    "ComfyUI-Chord",
    "ComfyUI-TextureAlchemy",
    "ComfyUI-DreamTexture"
   ],
   "params": [
    {
     "key": "prompt",
     "label": "提示词",
     "type": "string",
     "multiline": true,
     "target": "dt.positive.text",
     "prefix": "2d seamless hand-painted texture, ",
     "suffix": ", top down view, seamless tileable, flat even lighting, no shadows",
     "default": "stylized hand painted stone bricks with moss",
     "note": "前后缀会一并送给云端模型"
    },
    {
     "key": "api_model",
     "label": "云端模型",
     "type": "string",
     "target": null,
     "default": "",
     "note": "可用模型按你的 API 令牌实际权限列出",
     "widget": "imagen-model"
    },
    {
     "key": "api_quality",
     "label": "画质档",
     "type": "enum",
     "options": [
      "low",
      "medium",
      "high"
     ],
     "target": null,
     "default": "medium",
     "note": "直接决定单张花费与耗时"
    },
    {
     "key": "tile_fix",
     "label": "无缝重整",
     "type": "float",
     "target": "dt.sampler.denoise",
     "default": 0.45,
     "min": 0,
     "max": 0.85,
     "note": "云端出的图不保证无缝。本地 SDXL 用循环卷积重画一道可以让它可平铺，数值越大越无缝、也越偏离原图；0.35~0.55 通常够用。调成 0 则直接分解，不经过本地 SDXL，也就不需要下底模",
     "rewire_when_zero": [
      {
       "node": "dt.pbr_estimate",
       "input": "image",
       "source": "dt.source_scale",
       "slot": 0
      },
      {
       "node": "dt.out.source",
       "input": "images",
       "source": "dt.source_scale",
       "slot": 0
      }
     ],
     "drop_when_zero": [
      "dt.checkpoint",
      "dt.style_lora",
      "dt.seamless_model",
      "dt.seamless_vae",
      "dt.positive",
      "dt.negative",
      "dt.sampler",
      "dt.decode",
      "dt.source_encode"
     ]
    },
    {
     "key": "reference",
     "label": "参考图",
     "type": "image",
     "target": null,
     "note": "留空为纯文生图。给了参考图就走云端的图像编辑接口，在它基础上改"
    },
    {
     "key": "source_image",
     "label": "底图",
     "type": "image",
     "target": "dt.source_image.image",
     "note": "由后端填：云端出的图上传到 ComfyUI 之后的文件名",
     "hidden": true
    }
   ],
   "advanced": [
    {
     "key": "api_size",
     "label": "云端出图尺寸",
     "type": "enum",
     "options": [
      "1024x1024",
      "1536x1024",
      "1024x1536"
     ],
     "target": null,
     "default": "1024x1024",
     "note": "纹理基本只用正方形；非正方形会在缩放到工作分辨率时被拉伸"
    },
    {
     "key": "api_background",
     "label": "背景",
     "type": "enum",
     "options": [
      "opaque",
      "auto",
      "transparent"
     ],
     "target": null,
     "default": "opaque",
     "note": "transparent 用于贴花类素材；普通纹理保持 opaque"
    },
    {
     "key": "resolution",
     "label": "工作分辨率",
     "type": "enum",
     "options": [
      768,
      1024
     ],
     "target": [
      "dt.source_scale.width",
      "dt.source_scale.height"
     ],
     "default": 1024,
     "note": "云端出的图会先缩放到这个尺寸"
    },
    {
     "key": "negative",
     "label": "负面词",
     "type": "string",
     "multiline": true,
     "target": "dt.negative.text",
     "default": "perspective, vignette, cast shadow, specular highlight, blurry, watermark, text, border",
     "note": "只作用于本地的无缝重整那一道；云端接口不收负面词"
    },
    {
     "key": "seed",
     "label": "种子",
     "type": "int",
     "target": "dt.sampler.seed",
     "default": -1,
     "note": "只影响本地重整。云端接口不支持种子，同一提示词每次结果都不同"
    },
    {
     "key": "steps",
     "label": "步数",
     "type": "int",
     "target": "dt.sampler.steps",
     "default": 30,
     "min": 10,
     "max": 60
    },
    {
     "key": "cfg",
     "label": "CFG",
     "type": "float",
     "target": "dt.sampler.cfg",
     "default": 6,
     "min": 1,
     "max": 15
    },
    {
     "key": "sampler",
     "label": "采样器",
     "type": "string",
     "target": "dt.sampler.sampler_name",
     "default": "dpmpp_2m"
    },
    {
     "key": "scheduler",
     "label": "调度器",
     "type": "string",
     "target": "dt.sampler.scheduler",
     "default": "karras"
    },
    {
     "key": "ao_radius",
     "label": "AO 半径",
     "type": "int",
     "target": "dt.derive_ao.radius",
     "default": 36,
     "min": 4,
     "max": 64
    },
    {
     "key": "ao_strength",
     "label": "AO 强度",
     "type": "float",
     "target": "dt.derive_ao.strength",
     "default": 2.2,
     "min": 0,
     "max": 3
    }
   ]
  },
